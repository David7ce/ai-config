[
  {
    "label": "claude-plugins-official",
    "installs": [
      { "agent": "claude", "command": "claude", "args": ["plugin", "marketplace", "add", "anthropics/claude-plugins-official"] }
    ]
  },
  {
    "label": "frontend-design",
    "installs": [
      { "agent": "claude", "command": "claude", "args": ["plugin", "install", "frontend-design@claude-plugins-official", "--scope", "user"] }
    ]
  },
  {
    "label": "code-simplifier",
    "installs": [
      { "agent": "claude", "command": "claude", "args": ["plugin", "install", "code-simplifier@claude-plugins-official", "--scope", "user"] }
    ]
  },
  {
    "label": "ponytail",
    "installs": [
      { "agent": "claude", "shell": "claude plugin marketplace add DietrichGebert/ponytail && claude plugin install ponytail@ponytail --scope user" },
      { "agent": "codex", "command": "codex", "args": ["plugin", "marketplace", "add", "DietrichGebert/ponytail", "codex"] }
    ]
  },
  {
    "label": "caveman",
    "installs": [
      { "agent": "claude", "shell": "claude plugin marketplace add JuliusBrussee/caveman && claude plugin install caveman@caveman --scope user" },
      { "agent": "codex", "command": "npx", "args": ["skills", "add", "JuliusBrussee/caveman", "-a", "codex"] }
    ]
  },
  {
    "label": "chrome-devtools-mcp",
    "installs": [
      { "agent": "claude", "shell": "claude plugin marketplace add ChromeDevTools/chrome-devtools-mcp && claude plugin install chrome-devtools-mcp@chrome-devtools-plugins --scope user" }
    ]
  },
  {
    "label": "obsidian",
    "installs": [
      { "agent": "claude", "shell": "claude plugin marketplace add kepano/obsidian-skills && claude plugin install obsidian@obsidian-skills --scope user" }
    ]
  },
  {
    "label": "codex",
    "installs": [
      { "agent": "claude", "shell": "claude plugin marketplace add openai/codex-plugin-cc && claude plugin install codex@openai-codex --scope user" }
    ]
  },
  {
    "label": "cloudflare",
    "installs": [
      { "agent": "codex", "command": "npx", "args": ["codex-marketplace", "add", "openai/plugins/plugins/cloudflare", "--plugin"] }
    ]
  },
  {
    "label": "build-web-apps",
    "installs": [
      { "agent": "codex", "command": "npx", "args": ["codex-marketplace", "add", "openai/plugins/plugins/build-web-apps", "--plugin"] }
    ]
  },
  {
    "label": "higgsfield-ai/skills",
    "installs": [
      { "agent": "codex", "command": "npx", "args": ["codex-marketplace", "add", "higgsfield-ai/skills", "--plugin"] }
    ]
  },
  {
    "label": "canva",
    "installs": [
      { "agent": "codex", "command": "npx", "args": ["codex-marketplace", "add", "openai/plugins/plugins/canva", "--plugin"] }
    ]
  },
  {
    "label": "firecrawl-cli",
    "description": "init --all --browser",
    "installs": [{ "command": "npx", "args": ["-y", "firecrawl-cli@latest", "init", "--all", "--browser"] }]
  },
  {
    "label": "codebase-memory-mcp",
    "description": "installs its own MCP server + Claude Code hooks — see https://github.com/DeusData/codebase-memory-mcp",
    "installs": [
      {
        "agent": "claude",
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "irm https://raw.githubusercontent.com/DeusData/codebase-memory-mcp/main/install.ps1 | iex"]
      }
    ]
  },
  {
    "label": "context7",
    "description": "docs MCP server setup",
    "installs": [{ "command": "npx", "args": ["ctx7", "setup"] }]
  }
]
