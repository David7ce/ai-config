ips/videos\u0022 target=\u0022_blank\u0022\u003E\u003Cspan style=\u0022color: rgb(207, 19, 34);\u0022\u003Ehttps://www.youtube.com/@CgTopTips/videos\u003C/span\u003E\u003C/a\u003E\u003C/p\u003E","categories":["ControlNet"],"thumbnails":[{"width":1920,"url":"https://cdn.openart.ai/workflow_thumbnails/6p68g6DmcGocK9Gb5bgn/image_XOwRBID7_1724168180527_raw.jpg","height":1080},{"width":3508,"url":"https://cdn.openart.ai/workflow_thumbnails/6p68g6DmcGocK9Gb5bgn/image_C5rNE068_1724168331190_raw.jpg","height":4040}],"nodes_count":{"total":17,"primitive":2,"custom":15}}}